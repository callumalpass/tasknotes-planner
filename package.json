{
  "name": "tasknotes-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "contracts:sync": "node scripts/sync-canonical-task-pack.mjs",
    "manifest": "node scripts/write-manifest.mjs",
    "manifest:dev": "node scripts/write-manifest.mjs --development",
    "dev": "pnpm manifest:dev && vite",
    "dev:e2e": "pnpm manifest:dev && vite --mode e2e",
    "deploy:dev": "node scripts/deploy-pages-dev.mjs",
    "deploy:production": "node scripts/deploy-pages-production.mjs",
    "build": "pnpm manifest && tsc -b && vite build && node scripts/write-static-routes.mjs && node scripts/verify-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:production-smoke": "node scripts/production-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/azeret-mono": "5.3.0",
    "@mdbase-dev/connect": "file:vendor/mdbase-dev-connect-0.1.0-beta.96-43c3dedd61bb.tgz",
    "@tasknotes/model": "file:vendor/tasknotes-model-0.3.0-rc.11.tgz",
    "lucide-react": "1.25.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "2.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mdbase-dev/connect-protocol": "file:vendor/mdbase-dev-connect-protocol-0.1.0-beta.96-43c3dedd61bb.tgz",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@mdbase-dev/connect-protocol": "file:vendor/mdbase-dev-connect-protocol-0.1.0-beta.96-43c3dedd61bb.tgz",
      "@mdbase-dev/connect-sync": "file:vendor/mdbase-dev-connect-sync-0.1.0-beta.96-43c3dedd61bb.tgz"
    }
  }
}
